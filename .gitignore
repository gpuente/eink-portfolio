# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# turborepo cache
.turbo/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# playwright-mcp screenshots/snapshots scratch dir
.playwright-mcp/

# rag-server source documents — keep the folder (via .gitkeep) but
# ignore the contents. Reference material may include personal data
# (full CV, LinkedIn export, etc.) and shouldn't be tracked.
apps/rag-server/sources/*
!apps/rag-server/sources/.gitkeep

# bench runs (one JSON per invocation, partitioned by base_url). Useful
# locally for comparing runs; not worth checking in.
apps/rag-server/bench-results/
