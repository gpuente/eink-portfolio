# OpenAI — chat (gpt-4o-mini) + embeddings (text-embedding-3-small)
OPENAI_API_KEY=

# Astra DB (DataStax) — vector database
# Get these from https://astra.datastax.com/ → your DB → "Generate Token" / "API Endpoint"
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_KEYSPACE=default_keyspace

# Server
PORT=3001
# Comma-separated list of origins allowed to call this server (the Astro web app, etc).
# Use * for any origin in dev, but lock down in production.
CORS_ORIGIN=http://localhost:4321

# --- Guardrails (all optional; defaults shown below) ---
# Max chat requests per IP per rolling hour. Returns 429 when exceeded.
RATE_LIMIT_PER_HOUR=30
# Last N messages of conversation history sent to the LLM (older turns dropped).
MAX_HISTORY_MESSAGES=10
# Hard cap on tokens generated per assistant response.
MAX_OUTPUT_TOKENS=500
# Minimum cosine similarity for a retrieved chunk to be returned to the model.
# Below this, searchProfile returns [] and the model says "I don't have info".
RETRIEVAL_SIMILARITY_FLOOR=0.4

# --- GitHub (for the getGithubActivity agent tool) ---
# Username to query. Defaults to 'gpuente' if omitted.
GITHUB_USERNAME=gpuente
# Optional Personal Access Token. If set, bumps the GitHub REST rate limit from
# 60 req/h (anonymous, per IP) to 5000 req/h (authenticated). A classic PAT with
# NO scopes checked is enough for all public endpoints we use. Generate at:
#   https://github.com/settings/tokens?type=beta  (or classic)
GITHUB_TOKEN=

# --- Calendly (for the check-availability + book-slot agent tools) ---
#
# 1. Personal Access Token (PAT) — generate at:
#    https://calendly.com/integrations/api_webhooks → "Personal Access Tokens" → "Get a token now"
#    Copy the JWT (shown ONCE) and paste below. It's long, starts with "eyJ...".
#    Scopes are inherited from your account (the token gives full access, so keep it secret).
CALENDLY_PAT=
#
# 2. User URI — your own Calendly user resource URI. Discover it once via:
#      curl https://api.calendly.com/users/me -H "Authorization: Bearer $CALENDLY_PAT"
#    then copy the "uri" field from the response.
CALENDLY_USER_URI=
#
# 3. Event Type URI — the URI of the event type the agent will show/book. Discover via:
#      curl "https://api.calendly.com/event_types?user=$CALENDLY_USER_URI&active=true" \
#        -H "Authorization: Bearer $CALENDLY_PAT"
#    then copy the "uri" of the event type you want (e.g. "30 Min Meeting").
CALENDLY_EVENT_TYPE_URI=
#
# 4. Public scheduling URL — the calendly.com page the agent can share as a fallback
#    (or link to from confirmation messages). It's the "scheduling_url" field from GET /users/me
#    + the event type slug. Example: https://calendly.com/your-handle/30-min-meeting
CALENDLY_SCHEDULING_URL=
