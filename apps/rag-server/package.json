{
  "name": "@portfolio/rag-server",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "check": "tsc --noEmit",
    "ingest": "tsx --env-file=.env src/scripts/ingest.ts",
    "ingest:reset": "tsx --env-file=.env src/scripts/ingest.ts --reset",
    "bench": "tsx --env-file=.env src/scripts/bench.ts",
    "bench:local": "tsx --env-file=.env src/scripts/bench.ts --target local",
    "bench:prod": "tsx --env-file=.env src/scripts/bench.ts --target prod"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^3.0.104",
    "@ai-sdk/openai": "^2.0.0",
    "@datastax/astra-db-ts": "^2.0.0",
    "@hono/node-server": "^1.13.7",
    "ai": "^5.0.0",
    "hono": "^4.6.13",
    "pdf-parse": "^1.1.1",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.19.2",
    "typescript": "^6.0.2"
  }
}
