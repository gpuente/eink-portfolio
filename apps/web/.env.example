# URL of the rag-server (used by the chat agent in the floating panel).
# Astro exposes any env var prefixed with PUBLIC_ to the client bundle.
# In dev: leave as localhost. In production: set to the deployed rag-server URL.
PUBLIC_RAG_SERVER_URL=http://localhost:3001

# Boot overlay — when "true", the home page renders a fullscreen "device
# booting" splash that covers the SSR content until React hydrates and
# reads the saved language. Kills the brief EN→ES flash on refresh at
# the cost of ~700ms perceived delay. Leave as "false" to keep the
# snappier load path; flip to "true" for the branded boot moment.
PUBLIC_ENABLE_BOOT_OVERLAY=false

# Google Analytics 4 measurement ID (example: G-ABC123XYZ9).
# This is public client-side config; leave empty to disable analytics.
PUBLIC_GA_MEASUREMENT_ID=
