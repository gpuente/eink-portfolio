---
import { ClientRouter } from "astro:transitions";

type OgType = "website" | "article" | "profile";

type Props = {
	title?: string;
	description?: string;
	/** Path (relative to site root) or absolute URL of the social-preview image. 1200×630 recommended. */
	image?: string;
	/** Override the computed canonical URL (defaults to `Astro.site + current path`). */
	canonical?: string;
	/** Open Graph type. `website` for generic pages, `profile` for the /cv page, etc. */
	ogType?: OgType;
};

const {
	title = "Guillermo Puente · Portfolio",
	description = "Senior full-stack engineer with 10+ years shipping products across web, mobile, and desktop — recently focused on AI integration.",
	image = "/og-image.png",
	canonical,
	ogType = "website",
} = Astro.props;

// Absolute URLs. `Astro.site` comes from astro.config.mjs; in rare dev setups
// without it, fall back to the request origin so the tags still render.
const site = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).toString();
const absoluteImage = /^https?:\/\//.test(image)
	? image
	: new URL(image, site).toString();
const clarityProjectId = import.meta.env.PUBLIC_CLARITY_PROJECT_ID?.trim();
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim();

// Person schema for search engines — helps Google show a rich result when
// someone searches "Guillermo Puente". `sameAs` links the identity to the
// social accounts so the Knowledge Graph can cluster them.
const PERSON_JSONLD = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Guillermo Puente Sandoval",
	givenName: "Guillermo",
	familyName: "Puente Sandoval",
	url: site.toString(),
	jobTitle: "Senior Full-Stack Engineer",
	description:
		"Senior full-stack engineer with 10+ years shipping products across web, mobile, and desktop, recently focused on AI integration.",
	image: new URL("/apple-touch-icon.png", site).toString(),
	sameAs: [
		"https://github.com/gpuente",
		"https://www.linkedin.com/in/guillermo-puente-66125b54/",
		"https://twitter.com/memo_asd",
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonicalUrl} />

		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{/* Mobile browser chrome colour. Baseline matches the current mode via
		    prefers-color-scheme; EinkPortfolio also updates the first tag
		    dynamically when the user toggles the in-app light/dark switch. */}
		<meta name="theme-color" content="#e8e4db" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#3a3a36" media="(prefers-color-scheme: dark)" />

		{/* Open Graph — consumed by Facebook, WhatsApp, LinkedIn, Slack,
		    Discord, iMessage, and most link-preview scrapers. */}
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="Guillermo Puente" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={absoluteImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Guillermo Puente — Senior Full-Stack Engineer" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:locale:alternate" content="es_CL" />

		{/* Twitter / X card. `summary_large_image` is the wide banner format. */}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={absoluteImage} />
		<meta name="twitter:image:alt" content="Guillermo Puente — Senior Full-Stack Engineer" />
		<meta name="twitter:creator" content="@memo_asd" />
		<meta name="twitter:site" content="@memo_asd" />

		{/* JSON-LD Person schema so Google can tie the site to the human and
		    render a rich result for "Guillermo Puente" queries. */}
		<script type="application/ld+json" is:inline set:html={JSON.stringify(PERSON_JSONLD)}></script>
		{clarityProjectId && (
			<script is:inline define:vars={{ clarityProjectId }}>
				(function (c, l, a, r, i, t, y) {
					c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
					t = l.createElement(r);
					t.async = 1;
					t.src = "https://www.clarity.ms/tag/" + i;
					y = l.getElementsByTagName(r)[0];
					y.parentNode.insertBefore(t, y);
				})(window, document, "clarity", "script", clarityProjectId);
			</script>
		)}
		{gaMeasurementId && (
			<>
				<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
				<script is:inline define:vars={{ gaMeasurementId }}>
					(function () {
						if (!gaMeasurementId) return;

						window.dataLayer = window.dataLayer || [];
						// Canonical gtag shim: MUST use `arguments` (the array-like object),
						// NOT rest params `...args` (a real Array). gtag/js iterates the
						// dataLayer expecting Arguments objects; real Arrays get silently
						// dropped, so no /g/collect requests ever fire — the symptom is
						// "GA configured, script loaded, but zero hits in the property".
						// Also declared as `function gtag(){}` (not `window.gtag = fn`) to
						// mirror the exact pattern Google's docs use.
						window.gtag = window.gtag || function gtag() { window.dataLayer.push(arguments); };
						const analyticsState = window.__einkAnalytics || (window.__einkAnalytics = {
							pageLoadListenerAdded: false,
							clickListenerAdded: false,
						});
						window.gtag("js", new Date());
						window.gtag("config", gaMeasurementId, {
							send_page_view: false,
							anonymize_ip: true,
						});

						const trackPageView = function () {
							window.gtag("event", "page_view", {
								page_title: document.title,
								page_location: window.location.href,
								page_path: window.location.pathname + window.location.search,
							});
						};

						// `astro:page-load` fires on both the initial document load AND
						// every SPA navigation swap, so one listener covers both cases —
						// no manual initial trackPageView() call needed (that used to
						// double-count).
						if (!analyticsState.pageLoadListenerAdded) {
							document.addEventListener("astro:page-load", trackPageView);
							analyticsState.pageLoadListenerAdded = true;
						}

						if (!analyticsState.clickListenerAdded) {
							document.addEventListener("click", function (event) {
								if (!(event.target instanceof Element)) return;
								const anchor = event.target.closest("a[href]");
								if (!anchor) return;

								const href = anchor.getAttribute("href");
								if (!href || href.startsWith("#")) return;

								let url;
								try {
									url = new URL(href, window.location.href);
								} catch (_error) {
									return;
								}

								const isOutbound = url.origin !== window.location.origin;
								const isDownload = /\.(pdf|zip|docx?|xlsx?|pptx?|csv)$/i.test(url.pathname);

								if (isOutbound) {
									window.gtag("event", "click", {
										event_category: "outbound",
										event_label: url.href,
										link_url: url.href,
										outbound: true,
									});
								}

								if (isDownload) {
									const fileName = url.pathname.split("/").pop() || "unknown";
									window.gtag("event", "file_download", {
										file_name: fileName,
										link_url: url.href,
									});
								}
							});
							analyticsState.clickListenerAdded = true;
						}
					})();
				</script>
			</>
		)}
		{/* Astro's SPA-style router: intercepts same-origin anchor clicks,
		    fetches the target, and swaps the body without a full reload.
		    Browser back/forward work natively. Scripts in the swapped
		    content re-execute via `astro:page-load`; the BootOverlay
		    uses a window-scoped flag (`window.__einkBootShown`) to skip
		    replaying on in-app navigations while still showing on full
		    reloads. */}
		<ClientRouter />
		{/* Pre-paint: read the saved language and theme from localStorage
		    and set `html[data-lang]` / `html[data-mode]` before the first
		    paint so CSS selectors and React `useState` initializers read
		    the correct values on first client render (no EN→ES /
		    light→dark flash after useEffect).

		    `data-astro-rerun` forces this to re-execute on every SPA
		    swap, not just full loads. Astro's view transitions reset
		    `<html>` attributes to what the target page's source declares,
		    so after a /cv → / back-nav `data-mode` / `data-lang` would
		    come back cleared — re-running the script restores them from
		    the authoritative source (localStorage) before React remounts. */}
		<script is:inline data-astro-rerun>
			(function () {
				try {
					var lang = localStorage.getItem("eink-lang");
					lang = lang === "es" || lang === "en" ? lang : "en";
					var mode = localStorage.getItem("eink-mode");
					mode = mode === "light" || mode === "dark" ? mode : "light";
					window.__einkLang = lang;
					window.__einkMode = mode;
					document.documentElement.setAttribute("data-lang", lang);
					document.documentElement.setAttribute("data-mode", mode);
				} catch (_) {
					window.__einkLang = "en";
					window.__einkMode = "light";
					document.documentElement.setAttribute("data-lang", "en");
					document.documentElement.setAttribute("data-mode", "light");
				}
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
