---
import { ClientRouter } from "astro:transitions";

type Props = {
	title?: string;
	description?: string;
};

const {
	title = "Guillermo Puente · Portfolio",
	description = "Senior full-stack engineer with 10+ years shipping products across web, mobile, and desktop — recently focused on AI integration.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{/* Mobile browser chrome colour. Baseline matches the current mode via
		    prefers-color-scheme; EinkPortfolio also updates the first tag
		    dynamically when the user toggles the in-app light/dark switch. */}
		<meta name="theme-color" content="#e8e4db" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#3a3a36" media="(prefers-color-scheme: dark)" />
		{/* Astro's SPA-style router: intercepts same-origin anchor clicks,
		    fetches the target, and swaps the body without a full reload.
		    Browser back/forward work natively. Scripts in the swapped
		    content re-execute via `astro:page-load`; the BootOverlay
		    uses a window-scoped flag (`window.__einkBootShown`) to skip
		    replaying on in-app navigations while still showing on full
		    reloads. */}
		<ClientRouter />
		{/* Pre-paint: read the saved language and theme from localStorage
		    and set `html[data-lang]` / `html[data-mode]` before the first
		    paint so CSS selectors and React `useState` initializers read
		    the correct values on first client render (no EN→ES /
		    light→dark flash after useEffect).

		    `data-astro-rerun` forces this to re-execute on every SPA
		    swap, not just full loads. Astro's view transitions reset
		    `<html>` attributes to what the target page's source declares,
		    so after a /cv → / back-nav `data-mode` / `data-lang` would
		    come back cleared — re-running the script restores them from
		    the authoritative source (localStorage) before React remounts. */}
		<script is:inline data-astro-rerun>
			(function () {
				try {
					var lang = localStorage.getItem("eink-lang");
					lang = lang === "es" || lang === "en" ? lang : "en";
					var mode = localStorage.getItem("eink-mode");
					mode = mode === "light" || mode === "dark" ? mode : "light";
					window.__einkLang = lang;
					window.__einkMode = mode;
					document.documentElement.setAttribute("data-lang", lang);
					document.documentElement.setAttribute("data-mode", mode);
				} catch (_) {
					window.__einkLang = "en";
					window.__einkMode = "light";
					document.documentElement.setAttribute("data-lang", "en");
					document.documentElement.setAttribute("data-mode", "light");
				}
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
