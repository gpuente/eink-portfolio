---
/**
 * CV page rendered at `/cv`.
 *
 * Both EN and ES content are rendered in the static HTML; a small inline
 * script applies the saved language from localStorage ("eink-lang", shared
 * with the main portfolio) before the first paint, flipping
 * `<html data-lang="…">`. CSS shows the matching `[data-cv-lang="…"]`
 * block and hides the other — no flash, no JS framework.
 *
 * Toggling on the CV also writes back to localStorage, so if the user
 * switches to Spanish here and then navigates to `/`, the main portfolio
 * also mounts in Spanish.
 *
 * Content lives in ./copy.ts (CV_COPY with en + es keys).
 *
 * Design goals
 * ─────────────
 * 1. ATS-safe: single column, standard section headings, real text,
 *    consistent date format. Both languages in the DOM — ATS parsers
 *    already handle multilingual documents and pick up both text layers.
 * 2. Print-optimised: `@page` A4 with 1.4cm margins; `@media print`
 *    strips the e-ink overlays and forces ink-on-paper colours. The
 *    hidden-language block stays hidden in print, so the PDF only
 *    contains the active language.
 * 3. Matches the portfolio aesthetic on screen (paper/ink palette,
 *    Newsreader + JetBrains Mono, grain + vignette overlays) but with
 *    warmer paper and higher-contrast ink to reduce visual fatigue.
 */
import { ArrowLeft, Download } from "lucide-react";

import Layout from "../../layouts/Layout.astro";
import { CV_COPY, type CvLang } from "./copy";
import CvLangToggle from "./CvLangToggle";
import CvThemeToggle from "./CvThemeToggle";

const LANGS: CvLang[] = ["en", "es"];
---

<Layout
  title="Guillermo Puente · CV"
  description="Curriculum vitae — Senior Software Engineer with 10+ years across web, mobile, desktop, and AI integration."
>
  <!-- Layout.astro's head-level pre-paint script has already set
       `html[data-lang]` from localStorage (shared "eink-lang" key),
       so the right-language block is visible on the first frame. -->

  <!-- Screen-only e-ink surface layers. Print CSS hides them. -->
  <div class="grain" aria-hidden="true"></div>
  <div class="vignette" aria-hidden="true"></div>

  <!-- Screen-only top bar: back + EN/ES toggle + print. Hidden in print.
       The toggle button holds both EN and ES labels in parallel spans;
       CSS shows only the currently active one (current language shown,
       matching the main-portfolio StatusBar convention). -->
  {/* Top-bar critical layout ships as inline styles on the elements so it
      survives the brief window during Astro's ClientRouter SPA swap when
      the new /cv stylesheet hasn't fully activated yet. Without this the
      right cluster jumps around (different each SPA nav) while the CSS
      catches up. Colours / borders fall back via `var(--paper, #ebe7de)`
      so they render even before the stylesheet loads. */}
  <div
    class="top-bar"
    style="position: sticky; top: 0; z-index: 50; background: var(--paper, #ebe7de); border-bottom: 1px dashed var(--ink-faint, #9c9890);"
  >
    <div
      class="top-bar-inner"
      style="box-sizing: content-box; display: flex; align-items: center; justify-content: space-between; gap: 12px; max-width: 1200px; margin: 0 auto; padding: 12px 24px; min-height: 44px;"
    >
      <a href="/" class="back" aria-label="Back to portfolio">
        {/* lucide ArrowLeft — a real icon reads as a clickable affordance
            where the plain `←` character blended into the mono label.
            Rendered server-side by Astro (no `client:*` directive)
            because it's purely presentational and doesn't need JS. */}
        <ArrowLeft size={14} strokeWidth={2} className="back-icon" aria-hidden="true" />
        <span data-cv-lang="en">{CV_COPY.en.backLabel}</span>
        <span data-cv-lang="es">{CV_COPY.es.backLabel}</span>
      </a>
      {/* Right cluster order matches the main StatusBar: action → lang →
          theme (theme rightmost). Placeholders for the client-only
          toggles reserve their layout space so the right cluster doesn't
          reshuffle as React hydrates — once mounted, each astro-island
          fills the slot with the actual toggle. */}
      <div
        class="top-bar-right"
        style="display: flex; align-items: center; gap: 10px;"
      >
        {/* Direct PDF download. One <a> per language in the DOM; the
            data-cv-lang CSS rule shows only the active one, so clicking
            always grabs the right file. */}
        {
          LANGS.map((l) => {
            const cc = CV_COPY[l];
            return (
              <a
                class="download-btn"
                data-cv-lang={l}
                href={cc.pdfHref}
                download={cc.pdfDownload}
                aria-label={cc.downloadLabel}
              >
                <Download size={12} strokeWidth={2} className="download-btn-icon" aria-hidden="true" />
                <span>{cc.downloadLabel}</span>
              </a>
            );
          })
        }
        {/* Reuses the portfolio's StatusBar ToggleButton + ThemeSwitch.
            Rendered client-only because their visuals depend on
            localStorage. `cv-island` class + inline min-width/height
            reserve the layout space so the right cluster doesn't jump
            while React hydrates on SPA nav from `/`. */}
        <CvLangToggle client:only="react" />
        <CvThemeToggle client:only="react" />
      </div>
    </div>
  </div>

  <main class="cv" role="main">
    {
      LANGS.map((lang) => {
        const c = CV_COPY[lang];
        return (
          <div data-cv-lang={lang} lang={lang}>
            {/* HEADER ─────────────────────────────────────────────── */}
            <section class="header" aria-label="Personal details">
              <h1>Guillermo Puente Sandoval</h1>
              <p class="headline">{c.headline}</p>
              <ul class="contact">
                <li>
                  <a href="mailto:guillermo.ps09@gmail.com">guillermo.ps09@gmail.com</a>
                </li>
                <li>
                  <a href="https://gpuente.me" target="_blank" rel="noreferrer">gpuente.me</a>
                </li>
                <li>
                  <a
                    href="https://www.linkedin.com/in/guillermo-puente-66125b54/"
                    target="_blank"
                    rel="noreferrer"
                  >
                    linkedin.com/in/guillermo-puente
                  </a>
                </li>
                <li>
                  <a href="https://github.com/gpuente" target="_blank" rel="noreferrer">
                    github.com/gpuente
                  </a>
                </li>
                <li>{c.contactLocation}</li>
                <li>{c.contactLangs}</li>
              </ul>
            </section>

            {/* SUMMARY — single dense paragraph */}
            <section class="block summary" aria-labelledby={`h-summary-${lang}`}>
              <h2 id={`h-summary-${lang}`}>{c.h_summary}</h2>
              <p>{c.summary}</p>
            </section>

            {/* SKILLS ─────────────────────────────────────────────── */}
            <section class="block" aria-labelledby={`h-skills-${lang}`}>
              <h2 id={`h-skills-${lang}`}>{c.h_skills}</h2>
              <dl class="skills">
                {c.skills.map((s) => (
                  <>
                    <dt>{s.label}</dt>
                    <dd>{s.value}</dd>
                  </>
                ))}
              </dl>
            </section>

            {/* EXPERIENCE ─────────────────────────────────────────── */}
            <section class="block allow-break" aria-labelledby={`h-exp-${lang}`}>
              <h2 id={`h-exp-${lang}`}>{c.h_exp}</h2>
              {c.experience.map((e) => (
                <article class="entry">
                  <div class="entry-head">
                    <h3>
                      {e.org} <span class="sep">—</span> {e.role}
                    </h3>
                    <p class="meta">
                      <span>{e.when}</span>
                      <span class="dot">·</span>
                      <span>{e.place}</span>
                    </p>
                  </div>
                  <ul>
                    {e.bullets.map((b) => <li>{b}</li>)}
                  </ul>
                </article>
              ))}

              <p class="prior-note">
                <strong>{c.priorBgLabel}</strong>
                <span class="sep-mid">·</span>
                {c.priorBgBody}
              </p>
            </section>

            {/* EDUCATION ──────────────────────────────────────────── */}
            <section class="block" aria-labelledby={`h-edu-${lang}`}>
              <h2 id={`h-edu-${lang}`}>{c.h_edu}</h2>
              <article class="entry">
                <div class="entry-head">
                  <h3>
                    {c.education.school} <span class="sep">—</span> {c.education.subtitle}
                  </h3>
                  <p class="meta"><span>{c.education.timespan}</span></p>
                </div>
                <p class="degree">{c.education.degree}</p>
                <p class="note" style="margin-top: 3px;" set:html={c.education.continuing} />
              </article>
            </section>
          </div>
        );
      })
    }
  </main>
</Layout>

<script>
  // Sync <html lang> with the data-lang the early inline script applied,
  // so screen readers read the correct language on first load. The React
  // `CvLangToggle` island keeps them in sync after hydration.
  const current =
    (document.documentElement.getAttribute("data-lang") as "en" | "es" | null) ??
    "en";
  document.documentElement.setAttribute("lang", current);
</script>

<style is:global>
  /* ─────────────────────────────────────────────────────────────────
     Google Fonts + base typography.
  ───────────────────────────────────────────────────────────────── */
  @import url("https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,400..600;1,400..600&family=JetBrains+Mono:wght@400;500&display=swap");

  /* Design tokens — contrast bumped from the portfolio's #2b2a27 to
     #1a1a1a to reduce visual fatigue on the beige paper. --ink-soft
     lightened slightly to preserve the hierarchy between primary and
     secondary text. Paper warmed from #e8e4db to #ebe7de.

     Dark palette is keyed on `html[data-mode="dark"]`, which the Layout
     pre-paint script sets from localStorage before first paint (shared
     `eink-mode` key with the main portfolio). CvThemeToggle in the top
     bar flips the attribute at runtime. */
  :root {
    --paper: #ebe7de;
    --paper-bright: #f3efe6;
    --ink: #1a1a1a;
    --ink-soft: #595651;
    --ink-faint: #9c9890;
  }
  html[data-mode="dark"] {
    --paper: #3a3a36;
    --paper-bright: #44443f;
    --ink: #dcd8cd;
    --ink-soft: #9a968c;
    --ink-faint: #6b675f;
  }

  * { box-sizing: border-box; }

  html,
  body {
    margin: 0;
    padding: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: "Newsreader", "Iowan Old Style", Georgia, serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* ─────────────────────────────────────────────────────────────────
     Language toggle — both EN and ES content blocks ship in the DOM.
     An inline script in <body> reads localStorage ("eink-lang") and
     sets `html[data-lang="…"]` before the first paint. These rules hide
     the inactive language. The `:not(...)` selector also handles the
     no-attribute case (defaults to EN).
  ───────────────────────────────────────────────────────────────── */
  html[data-lang="es"] [data-cv-lang="en"] { display: none !important; }
  html:not([data-lang="es"]) [data-cv-lang="es"] { display: none !important; }

  /* Grain + vignette — lighter than the portfolio to reduce visual noise
     on a text-heavy document. */
  .grain,
  .vignette {
    position: fixed;
    inset: 0;
    pointer-events: none;
  }
  .grain {
    z-index: 100;
    background-image:
      radial-gradient(rgba(0, 0, 0, 0.025) 1px, transparent 1px),
      radial-gradient(rgba(0, 0, 0, 0.018) 1px, transparent 1px);
    background-size:
      3px 3px,
      7px 7px;
    mix-blend-mode: multiply;
    opacity: 0.7;
  }
  /* Dark grain: white dots + screen blend so the texture shows against
     the dark paper background (multiply would hide into black). */
  html[data-mode="dark"] .grain {
    background-image:
      radial-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      radial-gradient(rgba(255, 255, 255, 0.028) 1px, transparent 1px);
    mix-blend-mode: screen;
    opacity: 0.5;
  }
  .vignette {
    z-index: 99;
    background: radial-gradient(
      ellipse at center,
      transparent 55%,
      rgba(80, 65, 40, 0.06) 90%,
      rgba(80, 65, 40, 0.1) 100%
    );
  }
  html[data-mode="dark"] .vignette {
    background: radial-gradient(
      ellipse at center,
      transparent 55%,
      rgba(0, 0, 0, 0.2) 90%,
      rgba(0, 0, 0, 0.35) 100%
    );
  }

  /* ─────────────────────────────────────────────────────────────────
     Screen-only top bar — back + download + lang + theme.
     Outer `.top-bar` keeps the full-bleed sticky background + border;
     `.top-bar-inner` mirrors the main portfolio's StatusBar layout
     (`max-width: 1200px; margin: 0 auto; padding: 12px 24px;`) so the
     right cluster on wide viewports sits at the same visual column
     as the StatusBar's toggles.
  ───────────────────────────────────────────────────────────────── */
  .top-bar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px dashed var(--ink-faint);
  }
  .top-bar-inner {
    /* `box-sizing: content-box` matches the main portfolio's StatusBar
       math (which uses the default content-box). With the CV's global
       `* { box-sizing: border-box }`, the same max-width + padding
       values would produce a 48px-narrower inner and 24px shorter
       height — making the right cluster land 24px left of the main's
       right cluster. content-box here forces parity. */
    box-sizing: content-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 12px 24px;
    min-height: 44px;
    color: var(--ink-soft);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .top-bar .back {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 160ms ease, transform 200ms ease;
  }
  .top-bar .back:hover {
    color: var(--ink);
  }
  /* Slide the arrow a touch left on hover — reinforces the "back"
     affordance without drifting into a heavy micro-interaction. */
  .top-bar .back:hover .back-icon {
    transform: translateX(-2px);
  }
  .top-bar .back-icon {
    display: inline-flex;
    transition: transform 200ms ease;
  }
  .top-bar-right {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  /* Reserve layout slots for the client-only toggles. Each React
     island ships as `<astro-island>`; until React mounts the island
     is empty and would take no space, reshuffling the right cluster
     mid-hydration (visible after SPA nav from `/` where hydration
     runs async). The explicit min dimensions match the actual toggle
     sizes: ToggleButton is `minWidth: 40` padding-box, and
     ThemeSwitch is exactly 40×22. */
  .top-bar-right > astro-island {
    display: inline-flex;
    align-items: center;
    min-width: 40px;
    min-height: 24px;
  }
  .top-bar .download-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--ink);
    color: var(--paper);
    border: none;
    border-radius: 999px;
    padding: 8px 14px;
    font-family: inherit;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: opacity 200ms ease;
  }
  .top-bar .download-btn:hover {
    opacity: 0.85;
  }
  .top-bar .download-btn-icon {
    display: inline-flex;
  }

  /* ─────────────────────────────────────────────────────────────────
     CV container
  ───────────────────────────────────────────────────────────────── */
  .cv {
    max-width: 780px;
    margin: 0 auto;
    padding: 44px 36px 80px;
    position: relative;
    z-index: 1;
  }

  /* Header */
  .cv h1 {
    margin: 0 0 4px;
    font-weight: 500;
    font-size: clamp(30px, 4.5vw, 40px);
    letter-spacing: -0.015em;
    line-height: 1.1;
  }
  .cv .headline {
    margin: 0 0 14px;
    font-style: italic;
    color: var(--ink-soft);
    font-size: 15px;
  }
  .cv .contact {
    list-style: none;
    margin: 0 0 4px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 5px 12px;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 10.5px;
    color: var(--ink-soft);
    letter-spacing: 0.02em;
  }
  .cv .contact li:not(:last-child)::after {
    content: "·";
    margin-left: 12px;
    color: var(--ink-faint);
  }
  .cv .contact a {
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .cv .contact a:hover {
    color: var(--ink);
    border-bottom-color: var(--ink-faint);
  }

  /* Blocks + headings */
  .cv .block {
    margin-top: 22px;
  }
  .cv h2 {
    margin: 0 0 10px;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--ink-soft);
    border-bottom: 1px solid var(--ink-faint);
    padding-bottom: 6px;
  }
  .cv h3 {
    margin: 0;
    font-weight: 500;
    font-size: 15px;
    letter-spacing: -0.005em;
    line-height: 1.3;
  }
  .cv h3 .sep {
    color: var(--ink-faint);
    font-weight: 400;
    margin: 0 4px;
  }
  .cv p {
    margin: 0 0 6px;
    line-height: 1.5;
    font-size: 13.5px;
  }

  /* Summary — tighter paragraph spacing */
  .cv .summary p {
    margin-bottom: 5px;
  }
  .cv .summary p:last-child {
    margin-bottom: 0;
  }

  /* Entry (experience, education) */
  .cv .entry {
    margin-bottom: 14px;
    break-inside: avoid;
    page-break-inside: avoid;
  }
  .cv .entry:last-child {
    margin-bottom: 0;
  }
  .cv .entry-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    margin-bottom: 6px;
  }
  .cv .entry-head .meta {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 10.5px;
    color: var(--ink-soft);
    letter-spacing: 0.06em;
    margin: 0;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .cv .entry-head .meta .dot {
    color: var(--ink-faint);
  }
  .cv .entry ul {
    margin: 5px 0 0 17px;
    padding: 0;
  }
  .cv .entry li {
    margin-bottom: 3px;
    line-height: 1.5;
    font-size: 13px;
  }
  .cv .entry li:last-child {
    margin-bottom: 0;
  }
  .cv .entry .degree {
    font-size: 13.5px;
    color: var(--ink);
    margin-bottom: 2px;
  }
  .cv .entry .note {
    font-size: 12.5px;
    color: var(--ink-soft);
    font-style: italic;
    margin-bottom: 0;
  }

  /* Skills — compact 2-col definition list */
  .cv .skills {
    margin: 0;
    display: grid;
    grid-template-columns: 120px 1fr;
    row-gap: 5px;
    column-gap: 16px;
    font-size: 13px;
  }
  .cv .skills dt {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding-top: 2px;
  }
  .cv .skills dd {
    margin: 0;
    line-height: 1.45;
  }

  /* Prior background note — a single compact line after the last
     experience entry, visually distinct from full entries so it reads as
     "context, not a role". Dashed top border + italic text + softer
     ink colour signal "background info". */
  .cv .prior-note {
    margin: 14px 0 0;
    padding-top: 10px;
    border-top: 1px dashed var(--ink-faint);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--ink-soft);
    font-style: italic;
  }
  .cv .prior-note strong {
    color: var(--ink);
    font-style: normal;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .cv .prior-note .sep-mid {
    color: var(--ink-faint);
    margin: 0 6px;
    font-style: normal;
  }

  /* Anti-orphan — avoid splitting a heading from its first entry. */
  .cv h2,
  .cv h3 {
    page-break-after: avoid;
    break-after: avoid;
  }

  /* ─────────────────────────────────────────────────────────────────
     PRINT — target 2 pages at A4.
     Hidden-language blocks stay hidden in print too (the display:none
     rule above has !important), so the PDF only carries the active
     language.
  ───────────────────────────────────────────────────────────────── */
  @page {
    size: A4;
    margin: 0;
  }

  @media print {
    *,
    *::before,
    *::after {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
      color-adjust: exact !important;
    }

    /* Always print in light mode regardless of the active theme. A
       dark-background PDF wastes ink and is harder to read on paper. */
    html[data-mode="dark"] {
      --paper: #ebe7de;
      --paper-bright: #f3efe6;
      --ink: #1a1a1a;
      --ink-soft: #595651;
      --ink-faint: #9c9890;
    }

    html {
      background: transparent !important;
    }

    body {
      background-color: var(--paper) !important;
      background-image:
        radial-gradient(rgba(0, 0, 0, 0.022) 1px, transparent 1px),
        radial-gradient(rgba(0, 0, 0, 0.016) 1px, transparent 1px) !important;
      background-size:
        3px 3px,
        7px 7px !important;
      background-position:
        0 0,
        1px 2px !important;
      color: var(--ink) !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .grain,
    .vignette,
    .top-bar {
      display: none !important;
    }

    .cv {
      max-width: 100%;
      margin: 0;
      padding: 10mm 14mm;
      font-size: 10pt;
      background: transparent;
    }

    /* Padding-top on blocks survives page breaks — gives a top offset on
       page 2. Negative margin compensates same-page gap so visual rhythm
       stays tight. */
    .cv .block {
      padding-top: 5mm;
      margin-top: -5mm;
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .cv .block:first-of-type {
      padding-top: 0;
      margin-top: 0;
    }
    .cv .block.allow-break {
      break-inside: auto;
      page-break-inside: auto;
    }
    .cv .entry {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .cv .block.allow-break .entry {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    /* Only experience entries need the cross-page top offset — education
       entries are short enough that padding-top would waste space. */
    .cv .block[aria-labelledby^="h-exp-"] .entry {
      padding-top: 8mm;
      margin-top: -8mm;
    }
    .cv .block[aria-labelledby^="h-exp-"] .entry:first-of-type {
      padding-top: 0;
      margin-top: 0;
    }

    .cv h1 {
      font-size: 22pt;
      margin-bottom: 1pt;
      color: var(--ink);
    }
    .cv .headline {
